# Sourced by openshell-gateway-homebrew-service under launchd.
# Points image discovery at Colima's Docker socket when /var/run/docker.sock
# is absent on macOS; runtime execution still uses the Apple Hypervisor VM driver.
# Do not require the socket file to exist yet: at login/boot launchd starts
# openshell-gateway in parallel with Colima before docker.sock is created.
if [ -z "${DOCKER_HOST:-}" ] && [ ! -S /var/run/docker.sock ] && [ ! -S "${HOME}/.docker/run/docker.sock" ] && {
  [ -S "${HOME}/.colima/default/docker.sock" ] || [ -d "${HOME}/.colima/default" ]
}; then
  export DOCKER_HOST="unix://${HOME}/.colima/default/docker.sock"
fi
