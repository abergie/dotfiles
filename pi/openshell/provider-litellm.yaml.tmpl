id: __PROFILE_ID__
display_name: __DISPLAY_NAME__
description: LiteLLM proxy inference (/v1) and Streamable HTTP MCP (/mcp) access
category: inference
inference_capable: true
credentials:
  - name: api_key
    description: LiteLLM API key injected as an OpenShell placeholder
    env_vars:
      - LITELLM_API_KEY
    required: true
    auth_style: bearer
    header_name: authorization
discovery:
  credentials:
    - api_key
endpoints:
  - host: __LITELLM_HOST__
    port: __LITELLM_PORT__
    protocol: rest
    access: read-write
    enforcement: enforce
binaries:
  - /usr/local/bin/node
