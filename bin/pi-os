#!/usr/bin/env bash
#
# pi-os -- launch Pi inside an NVIDIA OpenShell sandbox (local MicroVM or remote gateway)
#
# Defaults to the local 'openshell' Apple Hypervisor MicroVM gateway so switching
# 'openshell gateway select' to a remote/cloud gateway does not break local usage.
# Pass -g/--gateway <name> or --gateway-endpoint <url> to target a remote gateway.
# On local VM gateways, mounts the active project directory (or common repository
# root when inside a linked git worktree) into /sandbox/work via virtiofs and
# attaches one or more 1Password Environment-backed OpenShell providers
# (default: openshell-pi-dev).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
DOTFILES_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"

IMAGE="${PI_OPENSHELL_IMAGE:-pi-openshell:local}"
IMAGE_EXPLICIT=0
REMOTE_IMAGE="${PI_OPENSHELL_REMOTE_IMAGE:-}"
TEMPLATE="${PI_OPENSHELL_TEMPLATE:-}"
TEMPLATE_EXPLICIT=0
REMOTE_TEMPLATE="${PI_OPENSHELL_REMOTE_TEMPLATE:-}"
POLICY_FILE="${PI_OPENSHELL_POLICY:-$DOTFILES_ROOT/pi/openshell/policy.yaml}"
NO_POLICY=0
if [ "${PI_OPENSHELL_POLICY+set}" = "set" ] && [ -z "$PI_OPENSHELL_POLICY" ]; then
  NO_POLICY=1
fi
OP_READ_HELPER="$DOTFILES_ROOT/pi/openshell/op-read.sh"
HOST_SESSION_DIR="${PI_OPENSHELL_SESSION_DIR:-$HOME/.pi/agent/sessions/sandbox}"
LOCAL_GATEWAY_NAME="${PI_OPENSHELL_LOCAL_GATEWAY:-openshell}"
GATEWAY="${PI_OPENSHELL_GATEWAY:-$LOCAL_GATEWAY_NAME}"
GATEWAY_ENDPOINT="${PI_OPENSHELL_GATEWAY_ENDPOINT:-}"
GATEWAY_INSECURE="${PI_OPENSHELL_GATEWAY_INSECURE:-0}"
SANDBOX_NAME=""
KEEP_SANDBOX=0
DRY_RUN=0
RUN_SHELL=0

OP_ENVS=()
EXPLICIT_PROVIDERS=()

usage() {
  cat <<'EOF'
pi-os -- run Pi inside an OpenShell sandbox (local MicroVM or remote gateway)

Usage:
  pi-os [wrapper-options] [--] [pi-arguments...]

Wrapper options:
  -g, --gateway <name>       OpenShell gateway name (default: $PI_OPENSHELL_GATEWAY or openshell)
  --gateway-endpoint <url>   Direct OpenShell gateway endpoint URL (overrides -g)
  --gateway-insecure         Skip TLS certificate verification for gateway connections
  --local                    Target the local Apple Hypervisor gateway (shorthand for -g openshell)
  -e, --op-env <name>        1Password Environment name; repeatable for stacking
                             (default: $PI_OP_ENVS or $PI_OP_ENV or openshell-pi-dev)
  -p, --provider <name>      Explicit OpenShell provider to attach; repeatable
                             (default: derived from --op-env names)
  --image <ref>              Sandbox image reference (local default: pi-openshell:local;
                             remote default: $PI_OPENSHELL_REMOTE_IMAGE or gateway default)
  --template <name>          Sandbox template name (remote default: $PI_OPENSHELL_REMOTE_TEMPLATE)
  --policy <path>            Custom sandbox policy YAML file
  --no-policy                Omit --policy and use the gateway/template default policy
  --name <name>              Explicit sandbox name (default: auto-generated)
  --keep                     Keep the sandbox after Pi exits (default: --no-keep)
  --shell                    Start an interactive bash shell instead of pi
  --dry-run                  Print the resolved openshell command without executing
  -h, --help                 Show this help message
EOF
}

append_csv_or_val() {
  local target_arr="$1" raw="$2" item
  local IFS=','
  for item in $raw; do
    item="${item#" "}"
    item="${item%" "}"
    [ -n "$item" ] || continue
    if [ "$target_arr" = "OP_ENVS" ]; then
      OP_ENVS+=("$item")
    else
      EXPLICIT_PROVIDERS+=("$item")
    fi
  done
}

PI_ARGS=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    -g|--gateway)
      [ "$#" -ge 2 ] || { echo "pi-os: $1 requires a value" >&2; exit 2; }
      GATEWAY="$2"
      GATEWAY_ENDPOINT=""
      shift 2
      ;;
    --gateway-endpoint)
      [ "$#" -ge 2 ] || { echo "pi-os: --gateway-endpoint requires a value" >&2; exit 2; }
      GATEWAY_ENDPOINT="$2"
      shift 2
      ;;
    --gateway-insecure)
      GATEWAY_INSECURE=1
      shift
      ;;
    --local)
      GATEWAY="$LOCAL_GATEWAY_NAME"
      GATEWAY_ENDPOINT=""
      shift
      ;;
    -e|--op-env)
      [ "$#" -ge 2 ] || { echo "pi-os: $1 requires a value" >&2; exit 2; }
      append_csv_or_val OP_ENVS "$2"
      shift 2
      ;;
    -p|--provider)
      [ "$#" -ge 2 ] || { echo "pi-os: $1 requires a value" >&2; exit 2; }
      append_csv_or_val EXPLICIT_PROVIDERS "$2"
      shift 2
      ;;
    --image)
      [ "$#" -ge 2 ] || { echo "pi-os: --image requires a value" >&2; exit 2; }
      IMAGE="$2"
      IMAGE_EXPLICIT=1
      shift 2
      ;;
    --template)
      [ "$#" -ge 2 ] || { echo "pi-os: --template requires a value" >&2; exit 2; }
      TEMPLATE="$2"
      TEMPLATE_EXPLICIT=1
      shift 2
      ;;
    --policy)
      [ "$#" -ge 2 ] || { echo "pi-os: --policy requires a value" >&2; exit 2; }
      POLICY_FILE="$2"
      NO_POLICY=0
      shift 2
      ;;
    --no-policy)
      NO_POLICY=1
      shift
      ;;
    --name)
      [ "$#" -ge 2 ] || { echo "pi-os: --name requires a value" >&2; exit 2; }
      SANDBOX_NAME="$2"
      shift 2
      ;;
    --keep)
      KEEP_SANDBOX=1
      shift
      ;;
    --shell)
      RUN_SHELL=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      PI_ARGS+=("$@")
      break
      ;;
    *)
      PI_ARGS+=("$1")
      shift
      ;;
  esac
done

if [ "${#OP_ENVS[@]}" -eq 0 ]; then
  RAW_ENV_DEFAULT="${PI_OP_ENVS:-${PI_OP_ENV:-openshell-pi-dev}}"
  for tok in ${RAW_ENV_DEFAULT//,/ }; do
    [ -n "$tok" ] && OP_ENVS+=("$tok")
  done
fi

if [ "${#EXPLICIT_PROVIDERS[@]}" -eq 0 ] && [ -n "${PI_OPENSHELL_PROVIDERS:-${PI_OPENSHELL_PROVIDER:-}}" ]; then
  RAW_PROV_DEFAULT="${PI_OPENSHELL_PROVIDERS:-${PI_OPENSHELL_PROVIDER}}"
  for tok in ${RAW_PROV_DEFAULT//,/ }; do
    [ -n "$tok" ] && EXPLICIT_PROVIDERS+=("$tok")
  done
fi

sanitize_provider_id() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//'
}

PROVIDERS=()
if [ "${#EXPLICIT_PROVIDERS[@]}" -gt 0 ]; then
  PROVIDERS+=("${EXPLICIT_PROVIDERS[@]}")
else
  for env_name in "${OP_ENVS[@]}"; do
    pid="$(sanitize_provider_id "$env_name")"
    [ -n "$pid" ] && PROVIDERS+=("$pid")
  done
fi

GW_ARGS=()
if [ -n "$GATEWAY_ENDPOINT" ]; then
  unset OPENSHELL_GATEWAY
  GW_ARGS=(--gateway-endpoint "$GATEWAY_ENDPOINT")
  GW_LABEL="$GATEWAY_ENDPOINT"
else
  unset OPENSHELL_GATEWAY_ENDPOINT
  GW_ARGS=(-g "$GATEWAY")
  GW_LABEL="$GATEWAY"
fi
if [ "$GATEWAY_INSECURE" = "1" ] || [ "$GATEWAY_INSECURE" = "true" ]; then
  GW_ARGS+=(--gateway-insecure)
fi

PHYSICAL_CWD="$(pwd -P)"
PHYSICAL_HOME="$(cd "$HOME" && pwd -P)"

is_denied_mount_path() {
  local p="$1"
  case "$p" in
    /|/Users|/tmp|/private|/private/tmp|/private/var|/var|/etc|/usr|/System|"$PHYSICAL_HOME")
      return 0
      ;;
    "$PHYSICAL_HOME/.ssh"|"$PHYSICAL_HOME/.ssh"/*|\
    "$PHYSICAL_HOME/.gnupg"|"$PHYSICAL_HOME/.gnupg"/*|\
    "$PHYSICAL_HOME/.aws"|"$PHYSICAL_HOME/.aws"/*|\
    "$PHYSICAL_HOME/.azure"|"$PHYSICAL_HOME/.azure"/*|\
    "$PHYSICAL_HOME/.kube"|"$PHYSICAL_HOME/.kube"/*|\
    "$PHYSICAL_HOME/.config/op"|"$PHYSICAL_HOME/.config/op"/*|\
    "$PHYSICAL_HOME/.config/gcloud"|"$PHYSICAL_HOME/.config/gcloud"/*|\
    "$PHYSICAL_HOME/.pi"|"$PHYSICAL_HOME/.pi"/*)
      return 0
      ;;
  esac
  return 1
}

if [ "$NO_POLICY" -eq 0 ] && [ -n "$POLICY_FILE" ] && [ ! -f "$POLICY_FILE" ]; then
  echo "pi-os: sandbox policy file not found: $POLICY_FILE" >&2
  exit 1
fi

EXTRA_ENV_ARGS=()
IS_LOCAL_VM=1
DRIVER_JSON=""
GUEST_WORKDIR="/sandbox/work"

normalize_base_url() {
  python3 -c '
import re, sys
u = sys.argv[1].strip()
if not u:
    raise SystemExit(0)
if not re.match(r"^https?://", u, re.I):
    u = "https://" + u
u = re.sub(r"/(v1/?)?$", "", u.rstrip("/"))
print(u)
' "$1"
}

EXPLICIT_ENV_GH_TOKEN="${GH_TOKEN:-${GITHUB_TOKEN:-}}"

if [ "$DRY_RUN" -eq 1 ]; then
  if [ -n "$GATEWAY_ENDPOINT" ] || [ "$GATEWAY" != "$LOCAL_GATEWAY_NAME" ]; then
    IS_LOCAL_VM=0
  fi
  if [ -n "${LITELLM_BASE_URL:-}" ]; then
    NORM_URL="$(normalize_base_url "$LITELLM_BASE_URL")"
    [ -n "$NORM_URL" ] && EXTRA_ENV_ARGS+=(--env "LITELLM_BASE_URL=$NORM_URL")
  fi
  DRY_NAME="$(git config --get user.name 2>/dev/null || true)"
  DRY_EMAIL="$(git config --get user.email 2>/dev/null || true)"
  [ -n "$DRY_NAME" ] && EXTRA_ENV_ARGS+=(--env "GIT_AUTHOR_NAME=$DRY_NAME" --env "GIT_COMMITTER_NAME=$DRY_NAME")
  [ -n "$DRY_EMAIL" ] && EXTRA_ENV_ARGS+=(--env "GIT_AUTHOR_EMAIL=$DRY_EMAIL" --env "GIT_COMMITTER_EMAIL=$DRY_EMAIL")
else
  if ! command -v openshell >/dev/null 2>&1; then
    echo "pi-os: openshell CLI not found on PATH" >&2
    exit 1
  fi

  if ! GATEWAY_INFO_JSON="$(openshell gateway info "${GW_ARGS[@]}" -o json 2>/dev/null)"; then
    if [ -z "$GATEWAY_ENDPOINT" ] && [ "$GATEWAY" = "$LOCAL_GATEWAY_NAME" ]; then
      echo "pi-os: Local OpenShell gateway '$GATEWAY' is not reachable. Start it with:" >&2
      echo "  brew services restart nvidia/openshell/openshell" >&2
      echo "  openshell gateway add https://localhost:17670 --local --name $GATEWAY" >&2
      echo "Or target a remote gateway with: pi-os -g <gateway-name>" >&2
    else
      echo "pi-os: OpenShell gateway '$GW_LABEL' is not reachable." >&2
      echo "Verify the remote gateway endpoint/tunnel is active (check 'openshell gateway list' and 'openshell status ${GW_ARGS[*]}')." >&2
    fi
    exit 1
  fi

  GATEWAY_LIST_JSON="$(openshell gateway list -o json 2>/dev/null || echo "[]")"
  IS_LOCAL_VM="$(python3 -c '
import json, sys, urllib.parse
info_raw, list_raw, gw_name, gw_endpoint, local_gw_name = sys.argv[1:6]
try:
    info = json.loads(info_raw) if info_raw.strip() else None
except Exception:
    info = None
if isinstance(info, dict) and "compute_drivers" in info:
    drivers = [d.get("name") for d in (info.get("compute_drivers") or []) if isinstance(d, dict)]
    has_vm = "vm" in drivers
    is_remote = False
    if gw_endpoint:
        host = (urllib.parse.urlparse(gw_endpoint).hostname or "").lower()
        is_remote = host not in ("localhost", "127.0.0.1", "::1")
    else:
        try:
            gws = json.loads(list_raw) if list_raw.strip() else []
        except Exception:
            gws = []
        for g in (gws if isinstance(gws, list) else []):
            if isinstance(g, dict) and g.get("name") == gw_name:
                is_remote = bool(g.get("is_remote"))
                break
    print("1" if (has_vm and not is_remote) else "0")
else:
    print("1" if (not gw_endpoint and gw_name == local_gw_name) else "0")
' "$GATEWAY_INFO_JSON" "$GATEWAY_LIST_JSON" "$GATEWAY" "$GATEWAY_ENDPOINT" "$LOCAL_GATEWAY_NAME")"

  # Note: 'openshell provider get' has no -o json flag in OpenShell 0.1.x;
  # query 'openshell provider list -o json' (metadata only, never secret values).
  ALL_PROVIDERS_JSON="$(python3 -c '
import json, subprocess, sys

gw_args = sys.argv[1:]
providers = []
token = ""
while True:
    cmd = ["openshell", "provider", "list", *gw_args, "-o", "json"]
    if token:
        cmd.extend(["--page-token", token])
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode != 0:
        raise SystemExit(1)
    payload = json.loads(res.stdout or "{}")
    providers.extend(payload.get("providers") or [])
    token = payload.get("next_page_token") or ""
    if not token:
        break
print(json.dumps(providers))
' "${GW_ARGS[@]}" 2>/dev/null || echo "[]")"

  EXPLICIT_MODE=0
  [ "${#EXPLICIT_PROVIDERS[@]}" -gt 0 ] && EXPLICIT_MODE=1

  RESOLUTION_OUT="$(python3 -c '
import json, sys, time

providers = json.loads(sys.argv[1])
explicit_mode = sys.argv[2] == "1"
requested = sys.argv[3:]
by_name = {p.get("name"): p for p in providers if p.get("name")}
now_ms = int(time.time() * 1000)

resolved = []
keys = set()

for req in requested:
    cand = by_name.get(req)
    if cand is None and not req.startswith("op-"):
        cand = by_name.get(f"op-{req}")
    if cand is None and not explicit_mode:
        by_type = [p for p in providers if p.get("type") == req and p.get("name")]
        if len(by_type) == 1:
            cand = by_type[0]
    if cand is None and not explicit_mode and len(requested) == 1 and req == "openshell-pi-dev":
        cand = by_name.get("op-litellm") or by_name.get("litellm")

    if cand is None:
        print(f"MISSING:{req}")
        raise SystemExit(0)

    exp = cand.get("credential_expires_at_ms") or {}
    for k, ts in exp.items():
        if isinstance(ts, (int, float)) and 0 < ts <= now_ms:
            print(f"EXPIRED:{cand["name"]}:{k}")
            raise SystemExit(0)

    resolved.append(cand["name"])
    if cand.get("type"):
        print("PTYPE:" + cand["type"])
    for field in ("config", "config_keys", "credentials", "credential_keys"):
        v = cand.get(field) or {}
        for k in (v.keys() if isinstance(v, dict) else v):
            keys.add(k)

print("OK:" + ",".join(resolved))
for k in sorted(keys):
    print("KEY:" + k)
' "$ALL_PROVIDERS_JSON" "$EXPLICIT_MODE" "${PROVIDERS[@]}")"

  STATUS_LINE="$(printf '%s\n' "$RESOLUTION_OUT" | grep -E '^(MISSING|EXPIRED|OK):' | head -n 1)"
  case "$STATUS_LINE" in
    MISSING:*)
      MISS_PROV="${STATUS_LINE#MISSING:}"
      echo "pi-os: OpenShell provider '$MISS_PROV' (or 'op-$MISS_PROV') is not configured on gateway '$GW_LABEL'." >&2
      echo "Connect your 1Password Environment to OpenShell in 1Password Desktop" >&2
      echo "(see $DOTFILES_ROOT/pi/openshell/README.md for setup steps)." >&2
      exit 1
      ;;
    EXPIRED:*)
      REST="${STATUS_LINE#EXPIRED:}"
      EXP_PROV="${REST%%:*}"
      EXP_KEY="${REST#*:}"
      echo "pi-os: 1Password credential '$EXP_KEY' on provider '$EXP_PROV' has expired." >&2
      echo "Open 1Password Desktop -> Developer -> View Environments and choose '... -> Send again'." >&2
      exit 1
      ;;
    OK:*)
      RESOLVED_CSV="${STATUS_LINE#OK:}"
      IFS=',' read -r -a PROVIDERS <<< "$RESOLVED_CSV"
      ;;
  esac

  PROVIDER_CONFIG_KEYS="$(printf '%s\n' "$RESOLUTION_OUT" | sed -n 's/^KEY://p')"
  PROVIDER_TYPES="$(printf '%s\n' "$RESOLUTION_OUT" | sed -n 's/^PTYPE://p')"

  # Derive LITELLM_BASE_URL from the attached inference_capable OpenShell profile(s)
  # (later stacked provider takes precedence) before falling back to op CLI.
  PROFILE_DERIVED_URL=""
  if [ -z "${LITELLM_BASE_URL:-}" ] && [ -n "$PROVIDER_TYPES" ]; then
    while IFS= read -r ptype; do
      [ -n "$ptype" ] || continue
      prof_json="$(openshell profile describe "${GW_ARGS[@]}" "$ptype" -o json 2>/dev/null || true)"
      [ -n "$prof_json" ] || continue
      cand_prof_url="$(printf '%s' "$prof_json" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    if d.get("inference_capable"):
        eps = d.get("endpoints") or []
        if eps and eps[0].get("host"):
            host = eps[0]["host"]
            port = eps[0].get("port") or 443
            scheme = "http" if port == 80 else "https"
            default_port = 80 if scheme == "http" else 443
            print(f"{scheme}://{host}" if port == default_port else f"{scheme}://{host}:{port}")
except Exception:
    pass
')"
      if [ -n "$cand_prof_url" ]; then
        PROFILE_DERIVED_URL="$cand_prof_url"
      fi
    done <<< "$PROVIDER_TYPES"
  fi

  # Resolve GH_TOKEN / GITHUB_TOKEN into a scoped OpenShell 'github' provider so
  # the real token never enters the sandbox as a plain environment variable.
  if [ -n "${PROVIDER_CONFIG_KEYS##*GH_TOKEN*}" ] && [ -n "${PROVIDER_CONFIG_KEYS##*GITHUB_TOKEN*}" ]; then
    RESOLVED_GH_TOKEN=""
    GH_SOURCE_ENV="${OP_ENVS[${#OP_ENVS[@]}-1]:-default}"
    if [ -x "$OP_READ_HELPER" ]; then
      for (( i=${#OP_ENVS[@]}-1; i>=0; i-- )); do
        env_name="${OP_ENVS[i]}"
        cand_token="$("$OP_READ_HELPER" --env "$env_name" GH_TOKEN 2>/dev/null || true)"
        if [ -z "$cand_token" ]; then
          cand_token="$("$OP_READ_HELPER" --env "$env_name" GITHUB_TOKEN 2>/dev/null || true)"
        fi
        if [ -n "$cand_token" ]; then
          RESOLVED_GH_TOKEN="$cand_token"
          GH_SOURCE_ENV="$env_name"
          break
        fi
      done
    fi

    if [ -z "$RESOLVED_GH_TOKEN" ] && [ -n "$EXPLICIT_ENV_GH_TOKEN" ]; then
      RESOLVED_GH_TOKEN="$EXPLICIT_ENV_GH_TOKEN"
    fi

    if [ -z "$RESOLVED_GH_TOKEN" ] && command -v gh >/dev/null 2>&1; then
      RESOLVED_GH_TOKEN="$(gh auth token 2>/dev/null || true)"
    fi

    if [ -n "$RESOLVED_GH_TOKEN" ]; then
      GH_PROVIDER_NAME="github-$(sanitize_provider_id "$GH_SOURCE_ENV")"
      GH_PROVIDER_EXISTS="$(printf '%s' "$ALL_PROVIDERS_JSON" | python3 -c '
import json, sys
target = sys.argv[1]
print("1" if any(p.get("name") == target for p in json.load(sys.stdin)) else "0")
' "$GH_PROVIDER_NAME")"
      if [ "$GH_PROVIDER_EXISTS" = "1" ]; then
        GITHUB_TOKEN="$RESOLVED_GH_TOKEN" GH_TOKEN="$RESOLVED_GH_TOKEN" \
          openshell provider update "${GW_ARGS[@]}" "$GH_PROVIDER_NAME" --credential GITHUB_TOKEN --credential GH_TOKEN >/dev/null
      else
        GITHUB_TOKEN="$RESOLVED_GH_TOKEN" GH_TOKEN="$RESOLVED_GH_TOKEN" \
          openshell provider create "${GW_ARGS[@]}" --name "$GH_PROVIDER_NAME" --type github --credential GITHUB_TOKEN --credential GH_TOKEN >/dev/null
      fi
      PROVIDERS+=("$GH_PROVIDER_NAME")
    fi
  fi

  # Resolve Git author/committer identity:
  # 1. Check 1Password Environment(s) for GIT_AUTHOR_NAME / GIT_AUTHOR_EMAIL / GIT_COMMITTER_NAME / GIT_COMMITTER_EMAIL
  # 2. Fall back to host git config (user.name, user.email)
  RESOLVED_GIT_NAME=""
  RESOLVED_GIT_EMAIL=""

  if [ -x "$OP_READ_HELPER" ]; then
    for (( i=${#OP_ENVS[@]}-1; i>=0; i-- )); do
      env_name="${OP_ENVS[i]}"
      cand_name="$("$OP_READ_HELPER" --env "$env_name" GIT_AUTHOR_NAME 2>/dev/null || true)"
      cand_email="$("$OP_READ_HELPER" --env "$env_name" GIT_AUTHOR_EMAIL 2>/dev/null || true)"
      [ -n "$cand_name" ] && [ -z "$RESOLVED_GIT_NAME" ] && RESOLVED_GIT_NAME="$cand_name"
      [ -n "$cand_email" ] && [ -z "$RESOLVED_GIT_EMAIL" ] && RESOLVED_GIT_EMAIL="$cand_email"
      [ -n "$RESOLVED_GIT_NAME" ] && [ -n "$RESOLVED_GIT_EMAIL" ] && break
    done
  fi

  if [ -z "$RESOLVED_GIT_NAME" ]; then
    RESOLVED_GIT_NAME="$(git config --get user.name 2>/dev/null || true)"
  fi
  if [ -z "$RESOLVED_GIT_EMAIL" ]; then
    RESOLVED_GIT_EMAIL="$(git config --get user.email 2>/dev/null || true)"
  fi

  if [ -n "$RESOLVED_GIT_NAME" ]; then
    EXTRA_ENV_ARGS+=(--env "GIT_AUTHOR_NAME=$RESOLVED_GIT_NAME" --env "GIT_COMMITTER_NAME=$RESOLVED_GIT_NAME")
  fi
  if [ -n "$RESOLVED_GIT_EMAIL" ]; then
    EXTRA_ENV_ARGS+=(--env "GIT_AUTHOR_EMAIL=$RESOLVED_GIT_EMAIL" --env "GIT_COMMITTER_EMAIL=$RESOLVED_GIT_EMAIL")
  fi

  # Merge non-concealed configuration variables across OP_ENVS (later env wins),
  # plus fallback LITELLM_BASE_URL lookup if concealed in 1Password.
  if [ -x "$OP_READ_HELPER" ]; then
    RAW_CFG_STREAM=""
    FALLBACK_BASE_URL="${PROFILE_DERIVED_URL:-}"
    for env_name in "${OP_ENVS[@]}"; do
      env_cfg="$("$OP_READ_HELPER" --list-unconcealed --env "$env_name" 2>/dev/null || true)"
      if [ -n "$env_cfg" ]; then
        RAW_CFG_STREAM="$RAW_CFG_STREAM"$'\n'"$env_cfg"
      fi
      if [ -z "${LITELLM_BASE_URL:-}" ] && [ -z "$PROFILE_DERIVED_URL" ]; then
        cand_url="$("$OP_READ_HELPER" --env "$env_name" LITELLM_BASE_URL 2>/dev/null || true)"
        if [ -n "$cand_url" ]; then
          FALLBACK_BASE_URL="$cand_url"
        fi
      fi
    done

    MERGED_LINES="$(python3 -c '
import re, sys
prov_keys = set(k.strip() for k in sys.argv[1].splitlines() if k.strip())
raw_lines = sys.argv[2].splitlines()
caller_url = sys.argv[3].strip()
fallback_url = sys.argv[4].strip()

merged = {}
if fallback_url and "LITELLM_BASE_URL" not in prov_keys:
    merged["LITELLM_BASE_URL"] = fallback_url

for line in raw_lines:
    if "=" not in line:
        continue
    k, v = line.split("=", 1)
    if k in prov_keys:
        continue
    merged[k] = v

if caller_url and "LITELLM_BASE_URL" not in prov_keys:
    merged["LITELLM_BASE_URL"] = caller_url

if "LITELLM_BASE_URL" in merged:
    u = merged["LITELLM_BASE_URL"].strip()
    if u and not re.match(r"^https?://", u, re.I):
        u = "https://" + u
    u = re.sub(r"/(v1/?)?$", "", u.rstrip("/"))
    if u:
        merged["LITELLM_BASE_URL"] = u
    else:
        del merged["LITELLM_BASE_URL"]

for k, v in merged.items():
    print(f"{k}={v}")
' "$PROVIDER_CONFIG_KEYS" "$RAW_CFG_STREAM" "${LITELLM_BASE_URL:-}" "$FALLBACK_BASE_URL")"

    if [ -n "$MERGED_LINES" ]; then
      while IFS= read -r kv; do
        [ -n "$kv" ] && EXTRA_ENV_ARGS+=(--env "$kv")
      done <<< "$MERGED_LINES"
    fi
  elif [ -n "${LITELLM_BASE_URL:-}" ]; then
    NORM_URL="$(normalize_base_url "$LITELLM_BASE_URL")"
    [ -n "$NORM_URL" ] && EXTRA_ENV_ARGS+=(--env "LITELLM_BASE_URL=$NORM_URL")
  fi
fi

if [ "$IS_LOCAL_VM" -eq 1 ]; then
  if is_denied_mount_path "$PHYSICAL_CWD"; then
    echo "pi-os: refusing to mount '$PHYSICAL_CWD' into the sandbox VM; cd into a project directory first." >&2
    exit 1
  fi

  MOUNT_SOURCE="$PHYSICAL_CWD"
  GUEST_WORKDIR="/sandbox/work"

  # When inside a git repository or linked worktree, mount the common repository
  # root (so linked worktree .git pointers resolve inside the VM) when the active
  # directory lives underneath that root.
  if git rev-parse --git-dir >/dev/null 2>&1; then
    COMMON_GIT_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    if [ -n "$COMMON_GIT_DIR" ] && [ "$(basename "$COMMON_GIT_DIR")" = ".git" ]; then
      COMMON_ROOT="$(cd "$(dirname "$COMMON_GIT_DIR")" && pwd -P)"
      if ! is_denied_mount_path "$COMMON_ROOT"; then
        case "$PHYSICAL_CWD" in
          "$COMMON_ROOT")
            MOUNT_SOURCE="$COMMON_ROOT"
            GUEST_WORKDIR="/sandbox/work"
            ;;
          "$COMMON_ROOT"/*)
            REL_SUBPATH="${PHYSICAL_CWD#"$COMMON_ROOT"/}"
            MOUNT_SOURCE="$COMMON_ROOT"
            GUEST_WORKDIR="/sandbox/work/$REL_SUBPATH"
            ;;
        esac
      fi
    fi
  fi

  mkdir -p "$HOST_SESSION_DIR"
  REAL_SESSION_DIR="$(cd "$HOST_SESSION_DIR" && pwd -P)"

  DRIVER_JSON="$(python3 -c '
import json, sys
print(json.dumps({
  "vm": {
    "mounts": [
      {
        "type": "bind",
        "source": sys.argv[1],
        "target": "/sandbox/work",
        "read_only": False,
      },
      {
        "type": "bind",
        "source": sys.argv[2],
        "target": "/sandbox/sessions",
        "read_only": False,
      },
    ]
  }
}, separators=(",", ":")))
' "$MOUNT_SOURCE" "$REAL_SESSION_DIR")"

  if [ "${#EXTRA_ENV_ARGS[@]}" -gt 0 ]; then
    EXTRA_ENV_ARGS=(--env "PI_CODING_AGENT_SESSION_DIR=/sandbox/sessions" "${EXTRA_ENV_ARGS[@]}")
  else
    EXTRA_ENV_ARGS=(--env "PI_CODING_AGENT_SESSION_DIR=/sandbox/sessions")
  fi
fi

SELECTED_TEMPLATE=""
if [ "$TEMPLATE_EXPLICIT" -eq 1 ]; then
  SELECTED_TEMPLATE="$TEMPLATE"
elif [ "$IS_LOCAL_VM" -eq 0 ] && [ -n "$REMOTE_TEMPLATE" ]; then
  SELECTED_TEMPLATE="$REMOTE_TEMPLATE"
elif [ -n "$TEMPLATE" ]; then
  SELECTED_TEMPLATE="$TEMPLATE"
fi

SELECTED_IMAGE=""
if [ "$IMAGE_EXPLICIT" -eq 1 ]; then
  SELECTED_IMAGE="$IMAGE"
elif [ -n "$SELECTED_TEMPLATE" ]; then
  SELECTED_IMAGE=""
elif [ "$IS_LOCAL_VM" -eq 1 ]; then
  SELECTED_IMAGE="$IMAGE"
elif [ -n "$REMOTE_IMAGE" ]; then
  SELECTED_IMAGE="$REMOTE_IMAGE"
elif [ -n "${PI_OPENSHELL_IMAGE:-}" ]; then
  SELECTED_IMAGE="$PI_OPENSHELL_IMAGE"
fi

CMD=(openshell sandbox create "${GW_ARGS[@]}")
if [ "$KEEP_SANDBOX" -eq 0 ]; then
  CMD+=(--no-keep)
fi
CMD+=(--no-auto-providers)
if [ -n "$SELECTED_TEMPLATE" ]; then
  CMD+=(--template "$SELECTED_TEMPLATE")
fi
if [ -n "$SELECTED_IMAGE" ]; then
  CMD+=(--from "$SELECTED_IMAGE")
fi
if [ "$NO_POLICY" -eq 0 ] && [ -n "$POLICY_FILE" ]; then
  CMD+=(--policy "$POLICY_FILE")
fi
for prov in "${PROVIDERS[@]}"; do
  CMD+=(--provider "$prov")
done
if [ -n "$DRIVER_JSON" ]; then
  CMD+=(--driver-config-json "$DRIVER_JSON")
fi
if [ "${#EXTRA_ENV_ARGS[@]}" -gt 0 ]; then
  CMD+=("${EXTRA_ENV_ARGS[@]}")
fi
if [ -n "$SANDBOX_NAME" ]; then
  CMD+=(--name "$SANDBOX_NAME")
fi

if [ "$IS_LOCAL_VM" -eq 1 ]; then
  CMD+=(-- /usr/local/bin/pi-sandbox-init --workdir "$GUEST_WORKDIR")
else
  CMD+=(-- sh -c 'if [ -x /usr/local/bin/pi-sandbox-init ]; then exec /usr/local/bin/pi-sandbox-init "$@"; else exec "$@"; fi' pi-os)
fi
if [ "$RUN_SHELL" -eq 1 ]; then
  CMD+=(bash)
else
  CMD+=(pi)
  if [ "${#PI_ARGS[@]}" -gt 0 ]; then
    CMD+=("${PI_ARGS[@]}")
  fi
fi

if [ "$DRY_RUN" -eq 1 ]; then
  printf '%s' "${CMD[0]}"
  for arg in "${CMD[@]:1}"; do
    printf ' %s' "$arg"
  done
  printf '\n'
  exit 0
fi

exec "${CMD[@]}"
