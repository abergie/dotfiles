#!/bin/sh
#
# dot
#
# `dot` handles installation, updates, things like that. Run it periodically
# to make sure you're on the latest and greatest.

set -e

parentDirectory="$(cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd -P)"
dotfilesDirectory="$(cd "$( dirname "$parentDirectory" )" && pwd -P)"

displayUsageAndExit() {
	echo "dot -- dotfiles management"
	echo ""
	echo "Usage: dot [options]"
	echo ""
	echo "Options:"
	echo "  -e, --edit    Open dotfiles directory for editing"
	echo "  -h, --help    Show this help message and exit"
	exit
}

while test $# -gt 0; do
	case "$1" in
		"-h"|"--help")
			displayUsageAndExit
			;;
		"-e"|"--edit")
			exec "$EDITOR" "$dotfilesDirectory"
			exit
			;;
		*)
			echo "Invalid option: $1"
			displayUsageAndExit
			;;
	esac
	shift
done

export ZSH=$HOME/.dotfiles

# macOS defaults should only be set during bootstrap, not every update.
# Run `script/bootstrap` to apply macOS defaults.

# Install homebrew
$ZSH/homebrew/install.sh 2>&1

# Upgrade Homebrew packages before recording the current system state.
echo "› brew upgrade"
brew update && brew upgrade --yes

# Keep the Brewfile aligned with packages installed outside this repository.
# The system is the source of truth; uninstalling a package requires updating
# the Brewfile manually (or running this command after the uninstall).
echo "› brew bundle dump"
brew bundle dump --file "$ZSH/Brewfile" --force

# Install software and run topic installers.
echo "› script/install"
$ZSH/script/install

# echo "› brew cleanup"
# brew cleanup
